# Database connection (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/saas_pricing

# Authentication (required, minimum 32 characters)
JWT_SECRET=your-minimum-32-character-secret-key-goes-here-abc123
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# AI Engine (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://pricelens.vercel.app,https://pricing-analyzer-32hw.vercel.app

# Email Service (Supports SendGrid or standard SMTP / Gmail)
FROM_EMAIL=noreply@pricelens.io

# Option A: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option B: SMTP (e.g. Gmail, Mailgun, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Analysis & Scraper Configuration (optional defaults)
ANALYSIS_TIMEOUT_SECONDS=240
ANALYSIS_DAILY_LIMIT=5
PLAYWRIGHT_BROWSERS_PATH=/opt/render/project/src/.playwright
